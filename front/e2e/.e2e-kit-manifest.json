    "**/*.e2e.spec.ts"
  ],
  "generatedFiles": [
    "e2e/playwright.config.ts",
    "e2e/scripts/run-e2e.cjs",
    "e2e/scripts/ci-e2e.cjs",
    "e2e/mocks/api.ts",
